[
  "Fui brasa viva en la oscuridad,",
  "Chispa que quiso brotar.",
  "Tantas noches que pasé",
  "soñando un nuevo lugar.",
  "Cruzo este incierto umbral",
  "sin saber a dónde irá.",
  "Ahora un incendio soy,",
  "dejando mi sombra",
  "en llamas.",
  "Canto en libertad.",
  "Convivo con las cenizas",
  "y el humo que me cubrió.",
  "Fui más impulso que voz,",
  "fui fuego que no quemó.",
  "Falto de respiración.",
  "Hoy me entrego al viento,",
  "aunque me haga vacilar.",
  "Si mi llama tiembla,",
  "me sostengo.",
  "Elijo arder más."
]
